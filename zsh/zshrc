#!/usr/bin/env zsh
# .zshrc is sourced for interactive shells
# This is where most of your shell customization should go

# Load modular rc files
for f in "$HOME/.init/zsh/rc.d/"*.zsh(N); do
  source "$f"
done
unset f

# NVM (interactive-only is fine, but not strictly required)
[ -s "$(brew --prefix)/opt/nvm/nvm.sh" ] && \
  . "$(brew --prefix)/opt/nvm/nvm.sh"
[ -s "$(brew --prefix)/opt/nvm/etc/bash_completion.d/nvm" ] && \
  . "$(brew --prefix)/opt/nvm/etc/bash_completion.d/nvm"

COMMON_SH="${INIT_DIR}/scripts/common.sh"
if ! source "${COMMON_SH}"; then
  echo "ERROR: failed to source ${COMMON_SH}" >&2
fi

if [[ -o interactive ]]; then
  export GORELEASER_KEY="$(${INIT_DIR}/bin/secret GORELEASER_KEY)"
  export GITHUB_TOKEN="$(${INIT_DIR}/bin/secret GITHUB_TOKEN)"
fi



# Set options
# setopt autocd              # change directory just by typing its name
# setopt interactivecomments # allow comments in interactive mode
# setopt magicequalsubst     # enable filename expansion for arguments of the form 'anything=expression'
# setopt promptsubst         # enable command substitution in prompt

# History settings
# HISTFILE=$HOME/.zsh_history
# HISTSIZE=10000
# SAVEHIST=10000
# setopt appendhistory
# setopt hist_expire_dups_first
# setopt hist_ignore_dups
# setopt hist_ignore_space
# setopt inc_append_history
# setopt share_history

# Key bindings
# bindkey -e  # emacs key bindings

# Aliases
# alias ls='ls -G'
# alias ll='ls -lh'
# alias la='ls -lah'
alias glo='git log --oneline -20'
alias wp-sync="rsync -avz --delete ./wordpress-root/ wp-deploy:/srv/wordpress/"

alias e=endless

# See https://chatgpt.com/share/693c3e5f-e10c-800a-aafb-2aad860352ce
alias dns='dns-sd -B _services._dns-sd._udp'
alias dns-smb='dns-sd -B _smb._tcp'
alias dns-http='dns-sd -B _http._tcp'
alias dns-https='dns-sd -B _https._tcp'

tmstart() {
  # Ensure background session exists with monitor-claude running
  if ! tmux has-session -t background 2>/dev/null; then
    tmux new-session -d -s background -n monitor-claude "$HOME/.init/bin/monitor-claude"
  fi
  tmux new -A -s active
}

# Prompt
PROMPT=$'%~\n$ '

# Plugin and theme setup would go here

# Endless: project activity monitor (prompt hook)
_endless_prompt_hook() {
  (endless-hook prompt "$PWD" &>/dev/null &)
}
precmd_functions+=(_endless_prompt_hook)

eval "$(endless shell-init)"

## ALWAYS HAVE THIS LAST
export PATH="${HOME}/.init/bin:${PATH}"
